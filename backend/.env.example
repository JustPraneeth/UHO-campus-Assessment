PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/online_exam
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLIENT_ORIGIN=http://localhost:5173
